  "semanticTokenColors": {
    "newOperator": "#9c958e",
    "stringLiteral": "#d4d4d8",
    "customLiteral": "#e7e5e4",
    "numberLiteral": "#a3a3a3",
    "class": "#a8a8b0",
    "interface": "#a8a8b0",
    "enum": "#a8a8b0",
    "struct": "#a8a8b0",
    "typeParameter": "#a8a8b0",
    "namespace": "#a8a8b0",
    "function": "#e7e5e4",
    "method": "#e7e5e4",
    "macro": "#b3aca4",
    "decorator": "#e7e5e4",
    "variable.readonly": "#bcbcc4",
    "property.readonly": "#bcbcc4",
    "enumMember": "#bcbcc4"
  },

  "tokenColors": [
    {
      "scope": ["meta.embedded", "source.groovy.embedded", "string meta.image.inline.markdown", "variable.legacy.builtin.python"],
      "settings": { "foreground": "#c6c6c6" }
    },
    { "scope": "emphasis", "settings": { "fontStyle": "italic" } },
    { "scope": "strong", "settings": { "fontStyle": "bold" } },
    { "scope": "header", "settings": { "foreground": "#b3aca4" } },

    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#707075" }
    },
    {
      "name": "Doc comment tags",
      "scope": ["comment.block.documentation storage.type.class", "comment.block.documentation entity.name.type", "comment.block.documentation keyword.other", "comment.block.documentation variable"],
      "settings": { "foreground": "#8a8a90" }
    },

    {
      "name": "Keywords — declarations, storage, modifiers (moonfly blue)",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.noexcept",
        "keyword.other.unit",
        "keyword.other.fn",
        "keyword.function",
        "keyword.declaration",
        "keyword.other.class",
        "keyword.other.struct",
        "keyword.other.enum",
        "keyword.other.interface",
        "keyword.other.type",
        "keyword.other.var",
        "keyword.other.let",
        "keyword.other.const",
        "keyword.other.def",
        "storage.type.function",
        "storage.type.class",
        "storage.type.interface",
        "storage.type.enum",
        "storage.type.type",
        "storage.type.namespace",
        "storage.type.property",
        "storage.type.primitive",
        "storage.type.built-in",
        "constant.language",
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.media-type",
        "support.constant.media",
        "support.type.vendored.property-name",
        "support.type.property-name"
      ],
      "settings": { "foreground": "#b3aca4" }
    },
    {
      "name": "Keywords — control flow (moonfly violet)",
      "scope": [
        "keyword.control",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.alignof",
        "keyword.operator.typeid",
        "keyword.operator.alignas",
        "keyword.operator.instanceof",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.operator.delete",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator",
        "entity.name.operator",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.flow",
        "keyword.control.loop",
        "keyword.control.conditional",
        "keyword.control.return",
        "keyword.control.trycatch",
        "keyword.control.exception",
        "keyword.control.as",
        "keyword.control.default",
        "keyword.control.directive",
        "keyword.other.import",
        "keyword.other.package",
        "keyword.other.namespace",
        "keyword.other.rust",
        "keyword.operator.expression.of",
        "keyword.operator.expression.in",
        "keyword.operator.expression.typeof",
        "keyword.operator.expression.keyof",
        "keyword.operator.expression.void",
        "keyword.operator.expression.is",
        "keyword.operator.expression.infer",
        "keyword.operator.expression.import",
        "keyword.control.at-rule",
        "keyword.control.import.include",
        "keyword.preprocessor"
      ],
      "settings": { "foreground": "#9c958e" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.separator.key-value", "punctuation.accessor"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Arrow / lambda / spread",
      "scope": ["storage.type.function.arrow", "keyword.operator.spread", "keyword.operator.rest"],
      "settings": { "foreground": "#b3aca4" }
    },

    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "meta.embedded.assembly", "string.tag", "string.value"],
      "settings": { "foreground": "#d4d4d8" }
    },
    {
      "name": "String interpolation punctuation",
      "scope": ["punctuation.definition.template-expression.begin", "punctuation.definition.template-expression.end", "punctuation.section.embedded", "punctuation.definition.interpolation"],
      "settings": { "foreground": "#b3aca4" }
    },
    {
      "name": "Interpolated expression contents",
      "scope": ["meta.template.expression", "meta.embedded.line", "meta.interpolation"],
      "settings": { "foreground": "#c6c6c6" }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape", "constant.character.format.placeholder"],
      "settings": { "foreground": "#ececec" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": { "foreground": "#a39d96" }
    },
    {
      "name": "Regex classes",
      "scope": ["constant.character.character-class.regexp", "constant.other.character-class.set.regexp", "constant.other.character-class.regexp", "constant.character.set.regexp"],
      "settings": { "foreground": "#a39d96" }
    },
    {
      "name": "Regex quantifiers / anchors",
      "scope": ["keyword.operator.or.regexp", "keyword.control.anchor.regexp", "keyword.operator.quantifier.regexp"],
      "settings": { "foreground": "#e7e5e4" }
    },
    {
      "name": "Regex group punctuation",
      "scope": ["punctuation.definition.group.regexp", "punctuation.definition.group.assertion.regexp", "punctuation.definition.character-class.regexp", "punctuation.character.set.begin.regexp", "punctuation.character.set.end.regexp", "keyword.operator.negation.regexp", "support.other.parenthesis.regexp"],
      "settings": { "foreground": "#a8a8b0" }
    },

    {
      "name": "Numbers",
      "scope": ["constant.numeric", "keyword.other.unit.suffix.floating-point"],
      "settings": { "foreground": "#a3a3a3" }
    },
    {
      "name": "Constants",
      "scope": ["constant.other", "constant.character", "variable.other.constant", "variable.other.enummember", "support.constant", "entity.name.constant"],
      "settings": { "foreground": "#bcbcc4" }
    },
    {
      "name": "Symbols / atoms",
      "scope": ["constant.other.symbol", "constant.other.key", "constant.other.placeholder"],
      "settings": { "foreground": "#a8a8b0" }
    },

    {
      "name": "Types, classes, interfaces (moonfly turquoise)",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.other.inherited-class",
        "entity.name.scope-resolution",
        "support.type",
        "support.class",
        "meta.type.cast.expr",
        "meta.type.new.expr",
        "meta.return-type",
        "storage.type.cs",
        "storage.type.generic.cs",
        "storage.type.modifier.cs",
        "storage.type.variable.cs",
        "storage.type.annotation.java",
        "storage.type.generic.java",
        "storage.type.java",
        "storage.type.object.array.java",
        "storage.type.primitive.array.java",
        "storage.type.primitive.java",
        "storage.type.token.java",
        "storage.type.groovy",
        "storage.type.annotation.groovy",
        "storage.type.parameters.groovy",
        "storage.type.generic.groovy",
        "storage.type.object.array.groovy",
        "storage.type.primitive.array.groovy",
        "storage.type.primitive.groovy",
        "entity.name.type.class.python",
        "support.type.python",
        "storage.type.rust",
        "entity.name.type.rust",
        "support.type.primitive",
        "storage.type.primitive.go",
        "storage.type.go",
        "entity.name.type.go",
        "entity.name.type.module",
        "entity.name.type.parameter",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.interface"
      ],
      "settings": { "foreground": "#a8a8b0" }
    },
    {
      "name": "Builtin type keywords stay blue",
      "scope": ["keyword.type", "support.type.builtin", "storage.type.built-in.primitive"],
      "settings": { "foreground": "#b3aca4" }
    },

    {
      "name": "Functions / methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "support.function",
        "support.constant.handlebars",
        "source.powershell variable.other.member",
        "entity.name.operator.custom-literal",
        "meta.function-call.generic",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": { "foreground": "#e7e5e4" }
    },
    {
      "name": "Decorators / annotations / attributes",
      "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator", "meta.annotation", "storage.type.annotation", "punctuation.definition.annotation", "entity.name.tag.annotation", "support.type.decorator", "meta.attribute.rust", "punctuation.definition.attribute.rust", "keyword.operator.attribute.inner.rust", "meta.attribute.cs", "punctuation.definition.annotation.java", "meta.declaration.annotation.java"],
      "settings": { "foreground": "#e7e5e4" }
    },
    {
      "name": "Macros / preprocessor",
      "scope": ["entity.name.function.macro", "entity.name.function.preprocessor", "meta.preprocessor", "meta.preprocessor.string", "meta.preprocessor.numeric"],
      "settings": { "foreground": "#b3aca4" }
    },

    {
      "name": "Variables, parameters, properties",
      "scope": [
        "variable",
        "variable.parameter",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.object",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable",
        "meta.object-literal.key",
        "support.variable.property",
        "meta.property-name",
        "meta.attribute.class.html"
      ],
      "settings": { "foreground": "#c9c4be" }
    },
    {
      "name": "this / self / super",
      "scope": ["variable.language", "variable.language.this", "variable.language.self", "variable.language.super", "support.variable.magic", "variable.other.predefined", "variable.other.global", "variable.parameter.function.language.special.self.python", "variable.parameter.function.language.special.cls.python"],
      "settings": { "foreground": "#b3aca4" }
    },
